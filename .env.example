# Optional. Without a key the app answers extractively (offline) and evals report LLM metrics as "not run".
# Any OpenAI compatible provider works. For OpenRouter use the base URL and model below.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# Refusal threshold on top cosine similarity. The tuned value is in eval/results/refusal.json.
REFUSAL_THRESHOLD=0.59
USE_RERANKER=0
