# Optional. Without a key the app answers extractively (offline) and evals report LLM metrics as "not run".
# Any OpenAI compatible provider works. Free options: Groq, Gemini (OpenAI compatible endpoint), OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Refusal threshold on top cosine similarity. The tuned value is in eval/results/refusal.json.
REFUSAL_THRESHOLD=0.35
USE_RERANKER=0
